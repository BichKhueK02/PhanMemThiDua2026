<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\ic_PhanMem.ico</ApplicationIcon>
    <StartupObject>PhanMemThiDua2026.Program</StartupObject>
    <!-- PHIÊN BẢN: NGUỒN DUY NHẤT. Module_PhienBan.SoftwareVersion đọc lại FileVersion này lúc chạy
         => mỗi lần phát hành chỉ sửa 4 dòng dưới đây (giữ 4 số giống nhau). -->
    <Version>1.2.352.0</Version>
    <AssemblyVersion>1.2.352.0</AssemblyVersion>
    <FileVersion>1.2.352.0</FileVersion>
    <InformationalVersion>1.2.352.0</InformationalVersion>
    <!-- Không gắn mã commit git vào "Product version" (tránh dạng 1.2.352.0+a1b2c3...) -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Tên nhà phát triển ở Company/Copyright; số liên hệ chỉ nằm trong Description
         (exe chỉ có số điện thoại thay cho tên bị phần mềm diệt virus đánh giá điểm tin cậy thấp). -->
    <Copyright>Copyright © 2026 TrungKien</Copyright>
    <PackageIcon>icon.ico</PackageIcon>
    <!-- CẤU HÌNH DPI CHUẨN HIỆN ĐẠI (THÊM MỚI VÀO ĐÂY) -->
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- AssemblyTitle = "File description" trong Properties > Details của exe -->
    <AssemblyTitle>Phần mềm Thi đua 2026</AssemblyTitle>
    <Title>PhanMemThiDua2026</Title>
    <Company>TrungKien</Company>
    <Authors>TrungKien</Authors>
    <Product>PhanMemThiDua2026</Product>
    <Description>Phần mềm quản lý, phân loại thi đua - khen thưởng 2026. Nhà phát triển: TrungKien - Liên hệ: 0975 2879 73</Description>
    <PackageProjectUrl>https://github.com/BichKhueK02/PhanMemThiDua2026</PackageProjectUrl>
  </PropertyGroup>
  <!-- HIỆU NĂNG KHỞI ĐỘNG
       - ReadyToRun: khi PUBLISH, biên dịch sẵn phần mềm + mọi thư viện NuGet (Krypton, Sqlite, ClosedXML...) ra mã máy x64.
         Form1/Form2/các trang không còn phải JIT những InitializeComponent khổng lồ lúc dựng => bớt các khối "đứng hình"
         trên luồng giao diện (gõ phím ở màn hình đăng nhập không khựng, nạp trước xong sớm hơn). Mã vẫn được tiered JIT
         tối ưu lại khi chạy nóng nên tốc độ lúc chạy lâu không giảm. Đánh đổi: tệp phát hành lớn hơn.
         Chỉ áp dụng khi có RuntimeIdentifier (publish win-x64); bản build F5 (Debug/Release thường) không đổi.
       - TieredPGO: tối ưu theo dữ liệu chạy thật cho mã nóng (mặc định .NET 8 đã bật, ghi rõ để không bị tắt nhầm). -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <!-- ServiceBackup / ServiceRestore là 2 dự án RIÊNG (có .csproj riêng) đặt trong thư mục này để tiện quản lý:
       KHÔNG được biên dịch chung vào phần mềm mẹ (trùng Program/AssemblyInfo => lỗi build). -->
  <!-- Tests\ là dự án kiểm thử xUnit RIÊNG (tham chiếu ngược vào dự án này) => cũng không biên dịch chung. -->
  <ItemGroup>
    <Compile Remove="ServiceBackup\**;ServiceRestore\**;Tests\**" />
    <EmbeddedResource Remove="ServiceBackup\**;ServiceRestore\**;Tests\**" />
    <None Remove="ServiceBackup\**;ServiceRestore\**;Tests\**" />
    <Content Remove="ServiceBackup\**;ServiceRestore\**;Tests\**" />
  </ItemGroup>
  <!-- Cho dự án kiểm thử gọi các lớp internal (Module_KetNoiCSDL, Module_QuyTacPhanLoai...). Không ảnh hưởng bản phát hành. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PhanMemThiDua2026.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="C:\Users\Asus ROG G531\.nuget\packages\pdfiumviewer.native.x86.v8-xfa\2018.4.8.256\Build\x86\pdfium.dll" />
    <Content Remove="C:\Users\Asus ROG G531\.nuget\packages\pdfiumviewer.native.x86_64.v8-xfa\2018.4.8.256\Build\x64\pdfium.dll" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\ic_PhanMem.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.9.0" />
    <PackageReference Include="Krypton.Toolkit" Version="105.26.4.110" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Office.Interop.Excel" Version="16.0.18925.20022" />
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Resources\icon.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EditorConfigFiles Remove="E:\PhanMemThiDua2026\.editorconfig" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include="E:\PhanMemThiDua2026\.editorconfig" />
    <None Include="Module_BaoMatAES.cs" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="bin\Release\net8.0-windows\" />
  </ItemGroup>
  <!-- TỆP KHÓA BẢO MẬT: khóa KHÔNG nằm trong .exe. Khi Build/Publish tệp được chép vào Database\KhoaBaoMat\
       (KHÔNG gói vào bên trong .exe single-file). Tệp nguồn KhoaBaoMat\ không đưa lên git (.gitignore). -->
  <ItemGroup Condition="Exists('KhoaBaoMat\PhanMemThiDua2026.pmtdkey')">
    <None Include="KhoaBaoMat\PhanMemThiDua2026.pmtdkey" Link="Database\KhoaBaoMat\PhanMemThiDua2026.pmtdkey">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>
  <Target Name="CanhBaoThieuTepKhoa" BeforeTargets="Build" Condition="!Exists('KhoaBaoMat\PhanMemThiDua2026.pmtdkey')">
    <Warning Text="Thiếu KhoaBaoMat\PhanMemThiDua2026.pmtdkey: phần mềm sẽ không chạy được nếu không chép tệp khóa vào thư mục phần mềm." />
  </Target>
</Project>